# ==================== Environment ====================
ENVIRONMENT=development

# ==================== Database (required) ====================
# PostgreSQL is required for production and Docker deployments.
DATABASE_URL=postgresql://ai_trader:changeme@localhost:5432/ai_trader
# Docker Compose service hostname:
# DATABASE_URL=postgresql://ai_trader:changeme@postgres:5432/ai_trader
# Unit tests only: ALLOW_SQLITE=true

# ==================== Redis (rate limiting + cache) ====================
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=ai_trader

# ==================== API Keys (optional) ====================
# Leave blank to use free yfinance (US stocks) and Binance (crypto) fallbacks.
ALPHA_VANTAGE_API_KEY=
# Optional: enrich US stock market-intel snapshots with Adanos sentiment.
ADANOS_API_KEY=

# ==================== Frontend ====================
# Frontend auto-refresh interval in milliseconds.
VITE_REFRESH_INTERVAL=300000

# ==================== Network / CORS ====================
CLAWTRADER_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://ai4trade.ai

# ==================== Market Data Endpoints ====================
ADANOS_API_BASE_URL=https://api.adanos.org
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
BINANCE_API_BASE_URL=https://api.binance.com
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz/info
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com

# ==================== Risk Management ====================
# Max fraction of portfolio value in one symbol (default 25%).
MAX_POSITION_PCT=0.25
# Max fraction of portfolio for a single new trade (default 10%).
MAX_SINGLE_TRADE_PCT=0.10

# ==================== Observability ====================
# Expose Prometheus metrics at GET /metrics (default true).
PROMETHEUS_METRICS_ENABLED=true

# ==================== Background Tasks ====================
# Never enable API background tasks in production — use worker.py instead.
AI_TRADER_API_BACKGROUND_TASKS=false
AI_TRADER_BACKGROUND_TASKS=prices,profit_history,polymarket_settlement,challenge_settlement,team_mission_form,team_contribution_score,team_mission_settlement,signal_quality_score,agent_metric_snapshots,network_edges,market_news,macro_signals,etf_flows,stock_analysis
AI_TRADER_WORKER_LOCK_FILE=/tmp/ai-trader-worker.lock
AI_TRADER_WORKER_LOCK_TIMEOUT_SECONDS=120
AI_TRADER_WORKER_NICE=10
PROFIT_HISTORY_PRUNE_ON_WORKER_START=false

POSITION_REFRESH_INTERVAL=300
MAX_PARALLEL_PRICE_FETCH=5
POLYMARKET_SETTLE_INTERVAL=60
MARKET_NEWS_REFRESH_INTERVAL=900
MACRO_SIGNAL_REFRESH_INTERVAL=900
ETF_FLOW_REFRESH_INTERVAL=900
STOCK_ANALYSIS_REFRESH_INTERVAL=1800
ADANOS_SENTIMENT_CACHE_TTL_SECONDS=300
ADANOS_SENTIMENT_TIMEOUT_SECONDS=4

# ==================== Profit History Retention ====================
PROFIT_HISTORY_FULL_RESOLUTION_HOURS=24
PROFIT_HISTORY_COMPACT_WINDOW_DAYS=7
PROFIT_HISTORY_COMPACT_BUCKET_MINUTES=15
PROFIT_HISTORY_PRUNE_INTERVAL_SECONDS=3600

# ==================== Price Fetch Reliability ====================
PRICE_FETCH_TIMEOUT_SECONDS=10
PRICE_FETCH_MAX_RETRIES=2
PRICE_FETCH_BACKOFF_BASE_SECONDS=0.35
PRICE_FETCH_ERROR_COOLDOWN_SECONDS=20
PRICE_FETCH_RATE_LIMIT_COOLDOWN_SECONDS=60
PRICE_FETCH_VERBOSE=true
HYPERLIQUID_SYMBOL_CACHE_TTL_SECONDS=300

# ==================== Market Intel (optional tuning) ====================
MARKET_NEWS_LOOKBACK_HOURS=48
MARKET_NEWS_CATEGORY_LIMIT=12
MARKET_NEWS_HISTORY_PER_CATEGORY=96
MACRO_SIGNAL_HISTORY_LIMIT=96
MACRO_SIGNAL_LOOKBACK_DAYS=20
BTC_MACRO_LOOKBACK_DAYS=7
ETF_FLOW_HISTORY_LIMIT=96
ETF_FLOW_LOOKBACK_DAYS=1
ETF_FLOW_BASELINE_VOLUME_DAYS=5
STOCK_ANALYSIS_HISTORY_LIMIT=120
MARKET_INTEL_STOCK_SYMBOLS=NVDA,AAPL,MSFT,AMZN,TSLA,META
MARKET_INTEL_STOCK_LATEST_CACHE_TTL=60
MARKET_INTEL_STOCK_FEATURED_CACHE_TTL=300
MARKET_INTEL_STOCK_QUOTE_CACHE_TTL=300
MARKET_INTEL_STOCK_QUOTE_FAILURE_CACHE_TTL=60
MARKET_INTEL_STOCK_QUOTE_STALE_AFTER_SECONDS=900

# ==================== OpenRouter (optional LLM enrichment) ====================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ==================== API Server ====================
API_STDERR_LOG=false
API_ACCESS_LOG=false
ALLOW_SYNC_PRICE_FETCH_IN_API=false

# ==================== Research Exports ====================
RESEARCH_EXPORT_HASH_SALT=ai-trader-research-v1
